{
  "type":"doc",
  "attrs":{
    "schema":"manydoc-prosemirror/1",
    "metadata":{"title":"Notes and references","author":"manydoc"},
    "layout":{"width":420,"height":420,"margin":36},
    "footers":[{"type":"paragraph","content":[{"type":"text","text":"Typed note references and independent note bodies"}]}],
    "notes":[
      {"kind":"endnote","id":"shared","content":[{"type":"paragraph","content":[{"type":"text","text":"END_NOTE_BODY: Additional context at the end of the document."}]}]},
      {"kind":"footnote","id":"alpha &<42>","content":[
        {"type":"paragraph","content":[{"type":"text","text":"FIRST_NOTE_BODY: ","marks":[{"type":"strong"}]},{"type":"text","text":"A linked source","marks":[{"type":"link","attrs":{"href":"https://example.invalid/note"}}]},{"type":"text","text":" and a list."}]},
        {"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","text":"Note list item"}]}]}]}
      ]},
      {"kind":"footnote","id":"shared","content":[{"type":"paragraph","content":[{"type":"text","text":"SECOND_NOTE_BODY: A second footnote with an independently scoped identity."}]}]}
    ]
  },
  "content":[
    {"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Notes and references"}]},
    {"type":"paragraph","content":[{"type":"text","text":"First reference"},{"type":"note_reference","attrs":{"kind":"footnote","id":"alpha &<42>"}},{"type":"text","text":" and an endnote"},{"type":"note_reference","attrs":{"kind":"endnote","id":"shared"}},{"type":"text","text":". Both reference identities survive persistence."}]},
    {"type":"ordered_list","attrs":{"order":3},"content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","text":"A note inside a list item"},{"type":"note_reference","attrs":{"kind":"footnote","id":"shared"}}]}]}]},
    {"type":"paragraph","content":[{"type":"text","text":"Repeated reference"},{"type":"note_reference","attrs":{"kind":"footnote","id":"alpha &<42>"}},{"type":"text","text":" points to the same first note."}]},
    {"type":"paragraph","content":[{"type":"text","text":"Body text remains above the measured footnote area. Note bodies keep formatting, links, and list structure."}]}
  ]
}
