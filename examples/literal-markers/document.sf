    "notes": [{"id": "label-note", "kind": "footnote", "content": [
      {"type": "paragraph", "content": [{"type": "text", "text": "A note referenced by the label itself."}]}
    ]}]
  },
  "content": [{"type": "ordered_list", "attrs": {"order": 1}, "content": [
    {"type": "list_item", "content": [
      {"type": "list_marker", "content": [{"type": "paragraph", "content": [
        {"type": "text", "text": "α)", "marks": [{"type": "strong"}, {"type": "link", "attrs": {"href": "https://example.org/alpha"}}]}
      ]}]},
      {"type": "paragraph", "content": [{"type": "text", "text": "A rich literal label owns its formatting and link."}]}
    ]},
    {"type": "list_item", "content": [
      {"type": "list_marker", "content": [{"type": "paragraph", "content": [
